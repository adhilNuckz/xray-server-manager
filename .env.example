# ==============================================================
# Xray VLESS Management Panel - Environment Configuration
# Copy this file to .env and adjust the values for your server.
# NEVER commit the real .env file to Git.
# ==============================================================

# Port the panel web server listens on (binds 0.0.0.0)
PANEL_PORT=5252

# --------------------------------------------------------------
# Hardcoded admin credentials (Phase 1 - no user database yet)
# Change these immediately after first deploy. They can also be
# changed later from the Settings page (stored securely as a
# bcrypt hash in the local SQLite database, overriding these).
# --------------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeThisPassword123!

# --------------------------------------------------------------
# Xray paths
# --------------------------------------------------------------
XRAY_BINARY=/usr/local/bin/xray
XRAY_CONFIG=/usr/local/etc/xray/config.json
XRAY_SYSTEMD_SERVICE=xray

# Public address used in generated VLESS links (domain preferred over raw IP)
SERVER_ADDRESS=vpn.solitways.online

# --------------------------------------------------------------
# Session security - generate with: openssl rand -hex 32
# --------------------------------------------------------------
SESSION_SECRET=GENERATE_SECURE_RANDOM_SECRET

# Directories (relative to project root unless absolute)
DATA_DIR=./data
BACKUPS_DIR=./backups

# Set to "production" when running behind PM2 on the real server.
# In production the backend also serves the built frontend (frontend/dist)
# so the whole panel is reachable on a single port.
NODE_ENV=development
